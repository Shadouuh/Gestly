{
  "name": "gestly",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "concurrently -n server,client -c green,blue \"npm run dev:server\" \"npm run dev:client\"",
    "dev:all": "concurrently -n ocr,server,client -c magenta,green,blue \"npm run dev:ocr\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:ocr": "npm run dev:ocr --workspace=server",
    "dev:server": "npm run dev --workspace=server",
    "dev:status": "node scripts/dev-status.mjs",
    "build": "npm run build --workspace=client",
    "seed": "npm run seed --workspace=server",
    "server:install": "npm install --workspace=server"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
